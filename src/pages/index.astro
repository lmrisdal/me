---
import '../styles/global.css';
import { profile, projects, experience } from '../data/portfolio';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(`${base}/`, Astro.site);
const sections = [{id:'home',label:'Overview'}, {id:'experience',label:'Experience'}, {id:'projects',label:'Projects'}, {id:'about',label:'Connect'}];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Lars Martin Risdal — Lead Developer at Evidi, based in Oslo. Frontend development, open-source tools, and a few side quests." />
    <meta name="theme-color" content="#efefea" />
    <meta property="og:title" content="Lars Martin Risdal · Developer" />
    <meta property="og:description" content="Frontend by day. Open-source side quests after hours. A developer's little corner of the internet." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <script is:inline>
      (() => {
        const system = window.matchMedia('(prefers-color-scheme: dark)');
        // Follow system is the default until a preference is saved.
        const key = 'portfolio-theme-preference';
        let preference = 'system';
        try {
          const saved = localStorage.getItem(key);
          if (saved === 'light' || saved === 'dark') preference = saved;
        } catch {}
        const apply = () => {
          const dark = preference === 'dark' || (preference === 'system' && system.matches);
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#09090c' : '#efefea');
          const button = document.getElementById('theme-control');
          if (button) {
            const labels = { system: 'Follow system', light: 'Light', dark: 'Dark' };
            const next = { system: 'light', light: 'dark', dark: 'system' };
            button.dataset.mode = preference;
            const label = `Theme: ${labels[preference]}. Switch to ${labels[next[preference]]}.`;
            button.setAttribute('aria-label', label);
            button.title = label;
          }
        };
        apply();
        system.addEventListener('change', () => {
          if (preference === 'system') apply();
        });
        document.addEventListener('DOMContentLoaded', () => {
          const control = document.getElementById('theme-control');
          apply();
          if (control) control.hidden = false;
          control?.addEventListener('click', () => {
            preference = { system: 'light', light: 'dark', dark: 'system' }[preference];
            apply();
            try { localStorage.setItem(key, preference); } catch {}
          });
        });
      })();
    </script>
    <title>Lars Martin Risdal · Developer</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="reading-progress" aria-hidden="true"></div>
    <aside class="rail">
      <a class="monogram" href="#home" aria-label="Lars Martin Risdal, home">LR<span>_</span></a>
      <nav aria-label="Sections">{sections.map((section,i)=><a href={`#${section.id}`} data-nav={section.id}><span class="nav-index">0{i}</span><span>{section.label}</span><span class="nav-indicator" aria-hidden="true">↗</span></a>)}</nav>
      <div class="rail-bottom"><a href={profile.github} aria-label="GitHub profile">GH ↗</a><span class="rail-note">OSLO / NORWAY</span><button id="theme-control" class="theme-control" type="button" data-mode="system" aria-label="Theme: Follow system. Switch to Light." title="Theme: Follow system. Switch to Light." hidden><svg data-mode-icon="system" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2h12v4h4v12h-4v4H6v-4H2V6h4z" fill="#eef3f5"/><path d="M18 6h4v12h-4v4H6v-4z" fill="#080d14"/><path d="M6 2h12v4h4v12h-4v4H6v-4H2V6h4z" fill="none" stroke="currentColor" stroke-width="1.5"/></svg><svg data-mode-icon="light" viewBox="0 0 24 24" aria-hidden="true" shape-rendering="crispEdges"><path d="M10 0h4v4h-4zM10 20h4v4h-4zM0 10h4v4H0zM20 10h4v4h-4zM6 6h12v12H6zM3 3h3v3H3zM18 3h3v3h-3zM3 18h3v3H3zM18 18h3v3h-3z" fill="currentColor"/></svg><svg data-mode-icon="dark" viewBox="0 0 24 24" aria-hidden="true" shape-rendering="crispEdges"><path d="M9 2H5v3H2v12h3v3h12v-3h3v-4h-7v-3H9z" fill="currentColor"/></svg></button></div>
    </aside>
    <main id="main">
      <section id="home" class="hero chapter" aria-labelledby="intro-title">
        <div class="hero-top mono"><span>PORTFOLIO / {new Date().getFullYear()}</span></div>
        <div class="signal" aria-hidden="true">
          <svg class="circuit" viewBox="0 0 500 500" fill="none">
            <defs><pattern id="circuit-grid" width="25" height="25" patternUnits="userSpaceOnUse"><path d="M25 0H0V25" stroke="currentColor" stroke-opacity=".08"/></pattern></defs>
            <path d="M0 0h500v500H0z" fill="url(#circuit-grid)"/>
            <g class="circuit-traces" stroke="currentColor" stroke-width="1">
              <path d="M20 100h110l70 70h70l70-70h140M0 150h105l70 70h135l55-55h135M30 410l110-110h90l80-80h95l95-95M75 500V380l75-75V170l80-80V0M290 500V380l70-70V190l65-65V0M500 375H380l-70-70H195l-65 65H0M500 425H355l-70-70h-75l-90 90H0"/>
            </g>
            <g class="circuit-pulses" stroke="currentColor" stroke-width="2" pathLength="100">
              <path pathLength="100" d="M0 150h105l70 70h135l55-55h135"/>
              <path pathLength="100" d="M30 410l110-110h90l80-80h95l95-95"/>
              <path pathLength="100" d="M290 500V380l70-70V190l65-65V0"/>
            </g>
            <g fill="var(--bg)" stroke="currentColor"><path d="M207 239h66v66h-66z"/><path d="M215 247h50v50h-50z" stroke-opacity=".35"/></g>
            <path d="m230 261-10 11 10 11m20-22 10 11-10 11" stroke="currentColor" stroke-width="2"/>
            <g fill="currentColor"><path d="M101 146h8v8h-8zM306 216h8v8h-8zM356 306h8v8h-8zM126 96h8v8h-8zM146 166h8v8h-8zM351 421h8v8h-8z"/></g>
          </svg>
        </div>
        <div class="hero-title"><p class="mono kicker"><span class="live-dot"></span> LEAD DEVELOPER @ EVIDI</p><h1 id="intro-title"><span>LARS</span><span class="name-outline">MARTIN</span><span>RISDAL<span class="accent">.</span></span></h1></div>
        <div class="hero-bottom"><p>Making the web work.<br/>Making room for curiosity.</p><a class="round-link" href="#experience"><span>Explore the work</span><span class="arrow-circle" aria-hidden="true">↓</span></a><span class="mono hero-counter">SCROLL TO DISCOVER / 01</span></div>
      </section>
      <section id="experience" class="chapter career-section" aria-labelledby="career-title">
        <header class="chapter-heading reveal"><span class="mono section-number">01 / THE DAY JOB</span><h2 id="career-title">Experience<span class="accent">_</span></h2><p>From writing the code<br/>to leading the frontend.</p></header>
        <div class="career-track">{experience.map((company,i)=><article class="company reveal"><div class="company-label"><span class="mono">{company.period}</span><h3><a href={company.url}>{company.company} ↗</a></h3><span class="company-number" aria-hidden="true">0{i+1}</span></div><div class="roles">{company.roles.map(role=><div class="role"><span class="timeline-dot" aria-hidden="true"></span><p class="mono role-date">{role.dates}</p><h4>{role.title}</h4>{role.description&&<p>{role.description}</p>}{role.skills&&<span class="mono skills">{role.skills}</span>}</div>)}</div></article>)}</div>
        <a class="inline-link" href={profile.linkedin}>The full story on LinkedIn <span>↗</span></a>
      </section>
      <section id="projects" class="chapter projects-section" aria-labelledby="projects-title">
        <header class="chapter-heading reveal"><span class="mono section-number">02 / AFTER HOURS</span><h2 id="projects-title">Side quests<span class="accent">.</span></h2><p>Small tools.<br/>Very personal problems.</p></header>
        {projects.map((project,i)=><article class={`project project-${i} reveal`}><div class="project-info"><p class="mono">0{i+1} / {project.category}</p><h3>{project.name}</h3><p class="project-description">{project.detail}</p><div class="project-links"><a class="inline-link" href={project.url}>Explore repository <span>↗</span></a><span class="mono">{project.language} / OPEN SOURCE</span></div></div><div class="project-demo">{i===0?<div class="controller-demo"><div class="chord-keys" aria-hidden="true"><span>LB</span><b>+</b><span>RB</span><b>+</b><span>A</span></div><div class="demo-line"></div><p class="mono">BUTTONS IN. POSSIBILITIES OUT.</p><button class="demo-button" type="button" data-demo="chord" aria-label="Try the chordio animation">Try a chord <span>↵</span></button><p class="demo-result mono" data-result="chord" aria-live="polite">DEMO / WAITING FOR INPUT</p></div>:<div class="tv-demo"><div class="tv-screen"><span class="tv-power" aria-hidden="true">◉</span><span class="mono">HDMI 01</span></div><div class="tv-stand"></div><button class="demo-button" type="button" data-demo="tv" aria-pressed="false">Wake display <span>↗</span></button><p class="demo-result mono" data-result="tv" aria-live="polite">INTERACTIVE PREVIEW / STANDBY</p></div>}</div></article>)}
        <a class="inline-link" href={`${profile.github}?tab=repositories`}>More experiments on GitHub <span>↗</span></a>
      </section>
      <section id="about" class="chapter about-section" aria-labelledby="about-title"><div class="about-top reveal"><span class="mono section-number">03 / THE HUMAN PART</span><p>I’m Lars, a developer in Oslo. I lead frontend development at Evidi, and spend some of my time outside work exploring Linux, gamepads, and better couch gaming setups.</p></div><div class="contact-composition reveal"><p class="mono">HAVE SOMETHING IN MIND?</p><h2 id="about-title">LET’S<br/><a href="mailto:lars@risdal.me">CONNECT<span class="accent">↗</span></a></h2></div><footer><span class="mono">© {new Date().getFullYear()} LARS MARTIN RISDAL</span><a href={profile.github}>GitHub ↗</a><a href="#home">Back to the surface ↑</a></footer></section>
    </main>
    <script>
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const reveals = document.querySelectorAll('.reveal');
      const revealObserver = new IntersectionObserver(entries => entries.forEach(entry => {
        if (entry.isIntersecting) { entry.target.classList.add('in-view'); revealObserver.unobserve(entry.target); }
      }), { threshold: 0.08 });
      reveals.forEach(element => { if (!reducedMotion.matches) element.classList.add('will-reveal'); revealObserver.observe(element); });
      const chapters = [...document.querySelectorAll<HTMLElement>('.chapter')];
      let scheduled = false;
      const updatePosition = () => {
        const distance = document.documentElement.scrollHeight - innerHeight;
        document.documentElement.style.setProperty('--progress', String(distance > 0 ? scrollY / distance : 0));
        const current = [...chapters].reverse().find(section => section.getBoundingClientRect().top <= innerHeight * .45) || chapters[0];
        document.querySelectorAll<HTMLAnchorElement>('[data-nav]').forEach(link => {
          if (link.dataset.nav === current.id) link.setAttribute('aria-current', 'location'); else link.removeAttribute('aria-current');
        });
        scheduled = false;
      };
      const schedulePosition = () => { if (!scheduled) { scheduled = true; requestAnimationFrame(updatePosition); } };
      addEventListener('scroll', schedulePosition, { passive: true });
      addEventListener('resize', schedulePosition);
      updatePosition();
      const chord = document.querySelector<HTMLButtonElement>('[data-demo="chord"]');
      let chordTimer: ReturnType<typeof setTimeout>;
      chord?.addEventListener('click', () => {
        const container = chord.closest('.controller-demo');
        container?.classList.add('fired');
        const result = document.querySelector('[data-result="chord"]');
        if (result) result.textContent = 'DEMO / CHORD DETECTED → ACTION LAUNCHED';
        clearTimeout(chordTimer);
        chordTimer = setTimeout(() => container?.classList.remove('fired'), 1000);
      });
      const television = document.querySelector<HTMLButtonElement>('[data-demo="tv"]');
      television?.addEventListener('click', () => {
        const on = television.getAttribute('aria-pressed') !== 'true';
        television.setAttribute('aria-pressed', String(on));
        television.closest('.tv-demo')?.classList.toggle('powered', on);
        television.innerHTML = on ? 'Sleep display <span>↘</span>' : 'Wake display <span>↗</span>';
        const result = document.querySelector('[data-result="tv"]');
        if (result) result.textContent = on ? 'INTERACTIVE PREVIEW / CONNECTED TO HDMI 01' : 'INTERACTIVE PREVIEW / STANDBY';
      });
    </script>
  </body>
</html>
